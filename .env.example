# Same values as the Folio web app (the anon key is public by design)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Your deployed Cloudflare Worker (must include the /details route)
TMDB_PROXY_URL=https://folio-tmdb-proxy.YOURNAME.workers.dev

# Where the Folio web app lives (used for "Create account" and "Open Folio" links)
FOLIO_APP_URL=https://folio.pages.dev

# Optional: your own add-on ID (email-style or GUID). Needed for signing and for stable storage.
EXTENSION_ID=folio-tracker@yourdomain.example
